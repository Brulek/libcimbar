        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumen"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "萤传用相机读取发送端屏幕上的动画码来接收文件。只在「扫码」页使用，画面不会上传。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumen uses the camera to read the animated code on the sender's screen. It's only used on the Scan tab, and nothing is uploaded."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在你点「存到相册」或打开了自动存相册时，把收到的图片和视频存进相册。萤传不会读取相册里的内容。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used only when you tap Save or turn on auto-save, to add received photos and videos to your library. Lumen never reads your photos."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
