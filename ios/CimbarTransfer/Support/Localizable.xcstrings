      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File already received — ready to share"
          }
        }
      }
    },
    "文件接收 100%": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File received 100%"
          }
        }
      }
    },
    "文件数据重组失败（错误 %d），可能是传输受损": {
