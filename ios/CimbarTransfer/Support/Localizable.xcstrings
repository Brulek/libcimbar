      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "8C (Legacy)"
          }
        }
      }
    },
    "写入文件失败，请检查设备可用存储空间": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to write the file. Check the available storage on this device."
          }
