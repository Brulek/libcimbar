{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "%@。点按「继续扫码」可重试": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Tap “Scan Again” to retry."
          }
        }
      }
    },
    "%lld 个文件 · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld files · %@"
          }
        }
      }
    },
    "%lld 分钟": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld min"
          }
        }
      }
    },
    "%lld 秒": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sec"
          }
        }
      }
    },
    "Lumen · 见屏即传": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumen · Transfer at a glance"
          }
        }
      }
    },
    "Micro 微码": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Micro"
          }
        }
      }
    },
    "Mini 小码": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini"
          }
        }
      }
    },
    "libcimbar 开源项目": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "libcimbar Open-Source Project"
          }
        }
      }
    },
    "一款基于 libcimbar 协议的离线文件接收工具": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An offline file receiver powered by the libcimbar protocol"
          }
        }
      }
    },
    "下一步": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next"
          }
        }
      }
    },
    "仍无新数据：试试靠近一点、调整角度避免反光，或调高发送端屏幕亮度": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still no new data. Try moving closer, changing the angle to avoid glare, or turning up the sender's screen brightness."
          }
        }
      }
    },
    "体积（大→小）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size (Largest First)"
          }
        }
      }
    },
    "保存": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        }
      }
    },
    "保存位置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Location"
          }
        }
      }
    },
    "保存失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save failed."
          }
        }
      }
    },
    "保存文件名": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved Filename"
          }
        }
      }
    },
    "保持稳定数秒，进度条到 100% 即接收完成": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold steady for a few seconds — the transfer is complete when the progress bar reaches 100%"
          }
        }
      }
    },
    "保留 30 天": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep for 30 Days"
          }
        }
      }
    },
    "保留 7 天": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep for 7 Days"
          }
        }
      }
    },
    "保留时长": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Files"
          }
        }
