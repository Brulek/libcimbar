    "原始文件名": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original Filename"
          }
        }
      }
    },
    "发送文件：在对方设备的浏览器打开 cimbar.org，选择文件生成动画码，用本机扫描即可。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To send files: open cimbar.org in a browser on the other device, choose a file to generate an animated code, then scan it with this device."
          }
        }
      }
    },
    "发送方在另一台设备上打开 libcimbar 网页或客户端，选择要发送的文件，会显示一段彩色动画码": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On another device, the sender opens the libcimbar web page or app and picks a file — a colorful animated code appears"
          }
        }
      }
    },
    "发送端网页（cimbar.org）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender Website (cimbar.org)"
          }
        }
      }
    },
    "发送端：在对方设备浏览器打开 cimbar.org": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To send: open cimbar.org in a browser on the other device"
          }
        }
      }
    },
    "取消": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
