      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share"
          }
        }
      }
    },
    "切换到「扫码」标签，对准发送端动画码即可开始接收": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to the Scan tab and point your camera at the sender's animated code to start receiving."
          }
        }
      }
    },
    "删除": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        }
      }
    },
    "删除 %lld 个": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete %lld Items"
          }
        }
      }
    },
    "删除所选文件": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Selected Files"
          }
        }
      }
    },
    "删除所选文件？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Selected Files?"
          }
